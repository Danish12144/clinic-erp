ENVIRONMENT=development

# Async URL used by the running app (asyncpg driver) — connects as the
# non-superuser `app_user` role (created by migration 0002) so Row-Level
# Security actually applies. NEVER point this at the postgres superuser.
DATABASE_URL=postgresql+asyncpg://app_user:app_user_dev_password_change_me@localhost:5433/clinic_erp
# Sync URL used only by Alembic migrations (psycopg2 driver) — needs
# superuser privileges to create tables/roles/policies, so this one DOES
# use postgres.
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5433/clinic_erp

# --- Neon (production) example ---
# Neon's own dashboard hands you a single libpq-style connection string
# with `?sslmode=require` (and often `&channel_binding=require`) — that
# works as-is for DATABASE_URL_SYNC (psycopg2), but paste the SAME string
# into DATABASE_URL (asyncpg) and app/core/config.py automatically rewrites
# `sslmode=` to `ssl=` and drops `channel_binding` before the engine ever
# connects — asyncpg's connect() has no `sslmode`/`channel_binding`
# keyword, only `ssl`, and would otherwise fail with a confusing
# `TypeError: connect() got an unexpected keyword argument 'sslmode'` on
# first use, in production, not at startup. See
# config.py::_normalize_asyncpg_ssl_params for the exact mechanism — you
# do NOT need to hand-edit the query string yourself either way.
#   DATABASE_URL=postgresql+asyncpg://<user>:<password>@<ep-xxxx>.neon.tech/<db>?sslmode=require
#   DATABASE_URL_SYNC=postgresql+psycopg2://<user>:<password>@<ep-xxxx>.neon.tech/<db>?sslmode=require
# Neon also gives every project a role with superuser-equivalent grants,
# not a real Postgres superuser — running migrations still needs whatever
# role Neon issues you (there is no separate `postgres` superuser to fall
# back to the way local Docker Postgres has one), and app_user (the
# RLS-respecting runtime role DATABASE_URL must use) must still be created
# by migration 0002 against that same database before first boot.

JWT_SECRET_KEY=change-me-to-a-long-random-value-before-any-real-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Accepts a JSON array (shown here) OR a plain comma-separated string
# (CORS_ORIGINS=https://a.com,https://b.com) — the latter is easier to type
# into Koyeb's single-text-field env var editor. See
# config.py::_parse_cors_origins. Add your Vercel production domain (and
# any preview-deployment domain you actually need) here in production.
CORS_ORIGINS=["http://localhost:3000"]

# Koyeb sets $PORT itself; the Dockerfile CMD's shell form expands it (and
# WEB_CONCURRENCY) directly into the uvicorn command line at container
# start — see Dockerfile. WEB_CONCURRENCY controls how many uvicorn worker
# processes run (each an independent process with its own DB connection
# pool). Neither is a Settings field in app/core/config.py; both are read
# only by the Dockerfile's CMD, not by application code.
WEB_CONCURRENCY=2

# "local" (default) writes uploaded files to disk under FILE_STORAGE_LOCAL_DIR.
# No other backend is implemented yet — see app/core/storage.py.
FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_DIR=./var/uploads

# "console" (default) logs and simulates success, no real provider call yet.
# See app/modules/notifications/adapters.py.
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
EMAIL_PROVIDER=console

# "mock" (default) simulates a gateway order, no real payment gateway call yet.
# See app/modules/billing/payment_gateway.py.
PAYMENT_GATEWAY_PROVIDER=mock
