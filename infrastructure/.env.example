# ==============================================================================
# Clinic ERP - Master Environment Configuration Template
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# Security & JWT Tokens
JWT_SECRET=super-secure-clinic-erp-secret-key-change-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=super-secure-refresh-clinic-erp-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=clinic_erp
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/clinic_erp?schema=public

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Frontend Client URL & CORS
CORS_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Clinic Brand & Metadata
CLINIC_NAME="Apex Health PolyClinic & Diagnostic Center"
CLINIC_CURRENCY="$"
CLINIC_TIMEZONE="UTC"
